rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function emailDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }
    function verifiedCompany(companyId) {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('[^@\\s]+@[^@\\s]+')
        && emailDomain().size() <= 253
        && emailDomain().matches('([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z]{2,63}')
        && !emailDomain().matches('(.+[.])?((gmail|googlemail|yahoo|ymail|rocketmail|hotmail|outlook|live|msn|icloud|me|mac|aol|protonmail|proton|fastmail|gmx|mail|zoho|yandex|rediffmail|hey|tuta|tutanota)[.](com|net|org|de|in|fr|ru|it|co[.]uk|co[.]in|co[.]jp|com[.]au)|pm[.]me)')
        && companyId == (emailDomain() == 'hp.com' ? 'hp' : emailDomain() == 'google.com' ? 'google' : emailDomain());
    }
    function validMembership(companyId) {
      let data = request.resource.data;
      return data.keys().hasAll(['emailDomain', 'role', 'status', 'workLocation', 'branch', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['emailDomain', 'role', 'status', 'workLocation', 'branch', 'createdAt', 'updatedAt'])
        && data.emailDomain == emailDomain()
        && data.role == 'member' && data.status == 'active'
        && data.workLocation is string && data.workLocation.size() <= 80
        && data.branch is string && data.branch.size() <= 80
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.displayName.matches('.*[^ ].*')
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && request.auth.token.email_verified == true
        && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && request.auth.token.email_verified == true
        && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      allow list, delete: if false;
    }
    match /communities/{companyId}/members/{uid} {
      // Only the owner sees their record; no member directory or client-created company metadata.
      // Re-check current signed identity on every request, not just when the record is created.
      allow get: if owner(uid) && verifiedCompany(companyId);
      allow create: if owner(uid) && verifiedCompany(companyId) && validMembership(companyId)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && verifiedCompany(companyId) && validMembership(companyId)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workLocation', 'branch', 'updatedAt']);
      // Prevent deletion/recreation from bypassing revocation. Revocation is a trusted Console operation for now.
      allow list, delete: if false;
    }
    function activeMember(companyId) {
      return verifiedCompany(companyId)
        && get(/databases/$(database)/documents/communities/$(companyId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function listingText(value, maximum) {
      return value is string && value.size() <= maximum && value.trim().size() > 0;
    }
    match /communities/{companyId}/listings/{listingId} {
      allow get: if activeMember(companyId);
      allow list: if activeMember(companyId) && request.query.limit <= 21;
      allow create: if activeMember(companyId)
        && request.resource.data.keys().hasOnly(['ownerId', 'title', 'description', 'category', 'pickup', 'pricePaise', 'status', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt == request.time
        && listingText(request.resource.data.title, 100)
        && listingText(request.resource.data.description, 1500)
        && listingText(request.resource.data.pickup, 120)
        && request.resource.data.category in ['goods', 'services']
        && request.resource.data.pricePaise is int
        && request.resource.data.pricePaise >= 0 && request.resource.data.pricePaise <= 100000000;
      allow update: if activeMember(companyId) && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'available' && request.resource.data.status == 'exchanged'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    // Other paths remain closed.
    match /{document=**} { allow read, write: if false; }
  }
}
