rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.displayName.matches('.*[^ ].*')
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && request.auth.token.email_verified == true
        && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && request.auth.token.email_verified == true
        && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      // No enumeration or client-side deletion; account deletion needs a coordinated data workflow.
      allow list, delete: if false;
    }
    // Future communities, membership, listings and messages stay closed until their rules are tested.
    match /{document=**} { allow read, write: if false; }
  }
}
