rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function emailDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }
    function personalDomain() { return emailDomain().matches('(.+[.])?((gmail|googlemail|yahoo|ymail|rocketmail|hotmail|outlook|live|msn|icloud|me|mac|aol|protonmail|proton|fastmail|gmx|mail|zoho|yandex|rediffmail|hey|tuta|tutanota)[.](com|net|org|de|in|fr|ru|it|co[.]uk|co[.]in|co[.]jp|com[.]au)|pm[.]me)'); }
    function verifiedCompany(companyId) {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('[^@\\s]+@[^@\\s]+')
        && emailDomain().size() <= 253
        && emailDomain().matches('([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[.])+[a-z]{2,63}')
        && !personalDomain()
        && companyId == (emailDomain() == 'hp.com' ? 'hp' : emailDomain() == 'google.com' ? 'google' : emailDomain());
    }
    function validMembership(companyId) {
      let data = request.resource.data;
      return data.keys().hasAll(['emailDomain', 'role', 'status', 'workLocation', 'branch', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['emailDomain', 'role', 'status', 'workLocation', 'branch', 'createdAt', 'updatedAt'])
        && data.emailDomain == emailDomain()
        && data.role == 'member' && data.status == 'active'
        && data.workLocation is string && data.workLocation.size() <= 80
        && data.branch is string && data.branch.size() <= 80
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.displayName.matches('.*[^ ].*')
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && request.auth.token.email_verified == true
        && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && request.auth.token.email_verified == true
        && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      allow list, delete: if false;
    }
    match /communities/{companyId}/members/{uid} {
      // Only the owner sees their record; no member directory or client-created company metadata.
      // Re-check current signed identity on every request, not just when the record is created.
      allow get: if owner(uid) && verifiedCompany(companyId);
      allow create: if owner(uid) && verifiedCompany(companyId) && validMembership(companyId)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && verifiedCompany(companyId) && validMembership(companyId)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workLocation', 'branch', 'updatedAt']);
      // Prevent deletion/recreation from bypassing revocation. Revocation is a trusted Console operation for now.
      allow list, delete: if false;
    }
    function verifiedPersonal() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string && request.auth.token.email.matches('[^@\\s]+@[^@\\s]+')
        && personalDomain();
    }
    function supportedArea(area) {
      return area in ['local:pune:baner:alacrity', 'local:pune:baner', 'local:pune'];
    }
    match /localityMemberships/{uid} {
      allow get: if owner(uid) && verifiedPersonal();
      allow create, update: if owner(uid) && verifiedPersonal()
        && request.resource.data.keys().hasOnly(['areaId']) && supportedArea(request.resource.data.areaId);
    }
    function localAccess(board) {
      let home = get(/databases/$(database)/documents/localityMemberships/$(request.auth.uid)).data.areaId;
      return supportedArea(home) && (board == home || board == 'local:pune'
        || (home == 'local:pune:baner:alacrity' && board == 'local:pune:baner'));
    }
    function activeMember(companyId) {
      return companyId.matches('local:.*') ? verifiedPersonal() && localAccess(companyId) : activeCompany(companyId);
    }
    function activeCompany(companyId) {
      return verifiedCompany(companyId)
        && get(/databases/$(database)/documents/communities/$(companyId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function listingText(value, maximum) {
      return value is string && value.size() <= maximum && value.trim().size() > 0;
    }
    function validDiscount(data) {
      let discount = data.discount;
      return data.category == 'services' && data.pickup == ''
        && discount is map
        && discount.keys().hasAll(['maxDiscountPaise', 'bookedBy', 'paymentTerms', 'failureTerms', 'cancellationTerms'])
        && discount.keys().hasOnly(['maxDiscountPaise', 'bookedBy', 'paymentTerms', 'failureTerms', 'cancellationTerms'])
        && discount.maxDiscountPaise is int
        && discount.maxDiscountPaise > data.pricePaise && discount.maxDiscountPaise <= 100000000
        && discount.bookedBy in ['helper', 'buyer']
        && listingText(discount.paymentTerms, 500)
        && listingText(discount.failureTerms, 500)
        && listingText(discount.cancellationTerms, 500);
    }
    function validAsk(data) {
      return !data.keys().hasAny(['discount'])
        && data.pricePaise == 0 && data.pickup == ''
        && data.askDeadline is timestamp
        && data.askDeadline > request.time
        && data.askDeadline <= request.time + duration.value(30, 'd');
    }
    match /communities/{companyId}/listings/{listingId} {
      allow get: if activeMember(companyId);
      allow list: if activeMember(companyId) && request.query.limit <= 21;
      allow create: if activeMember(companyId)
        && request.resource.data.keys().hasOnly(['ownerId', 'title', 'description', 'category', 'pickup', 'pricePaise', 'status', 'createdAt', 'discount', 'askDeadline'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt == request.time
        && listingText(request.resource.data.title, 100)
        && listingText(request.resource.data.description, 1500)
        && (request.resource.data.keys().hasAny(['askDeadline']) ? validAsk(request.resource.data)
          : request.resource.data.keys().hasAny(['discount'])
          ? validDiscount(request.resource.data) : listingText(request.resource.data.pickup, 120))
        && request.resource.data.category in ['goods', 'services']
        && request.resource.data.pricePaise is int
        && request.resource.data.pricePaise >= 0 && request.resource.data.pricePaise <= 100000000;
      function offerPath() {
        return /databases/$(database)/documents/communities/$(companyId)/listings/$(listingId);
      }
      function acceptingReplies() {
        let data = get(offerPath()).data;
        return !data.keys().hasAny(['askDeadline']) || data.askDeadline > request.time;
      }
      function validReplyNote() {
        let data = request.resource.data;
        return data.keys().hasAny(['note']) ? listingText(data.note, 500)
          : !get(offerPath()).data.keys().hasAny(['askDeadline']);
      }
      function reservation() {
        return /databases/$(database)/documents/communities/$(companyId)/listings/$(listingId)/private/reservation;
      }
      function buyerRequest(buyer) {
        return /databases/$(database)/documents/communities/$(companyId)/listings/$(listingId)/requests/$(buyer);
      }
      function seller() {
        return activeMember(companyId) && get(offerPath()).data.ownerId == request.auth.uid;
      }
      allow update: if participant() && resource.data.status == 'reserved'
        && request.resource.data.status == 'exchanged'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && getAfter(/databases/$(database)/documents/communities/$(companyId)/listings/$(listingId)/private/outcome).data.confirmedAt == request.time;
      allow update: if seller() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status in ['available','reserved'] && request.resource.data.status == 'exchanged')
        || (resource.data.status == 'available' && request.resource.data.status == 'reserved' && existsAfter(reservation())));
      match /requests/{buyer} {
        allow get: if activeMember(companyId) && (owner(buyer) || seller());
        allow list: if seller() && request.query.limit <= 20;
        allow create: if activeMember(companyId) && owner(buyer) && !seller()
          && get(offerPath()).data.status == 'available'
          && acceptingReplies()
          && request.resource.data.keys().hasOnly(['name','createdAt','status','note'])
          && validReplyNote()
          && listingText(request.resource.data.name,60) && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'pending';
        allow update: if seller() && resource.data.status == 'pending' && get(offerPath()).data.status == 'available'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (request.resource.data.status == 'declined' || (acceptingReplies() && request.resource.data.status == 'accepted'
          && getAfter(reservation()).data.buyer == buyer && getAfter(offerPath()).data.status == 'reserved'));
      }
      match /private/reservation {
        allow create: if seller() && request.resource.data.keys().hasOnly(['buyer'])
          && acceptingReplies()
          && request.resource.data.buyer is string && get(offerPath()).data.status == 'available'
          && getAfter(offerPath()).data.status == 'reserved'
          && getAfter(buyerRequest(request.resource.data.buyer)).data.status == 'accepted';
      }
      function participant() {
        let buyer = get(reservation()).data.buyer;
        return activeMember(companyId) && buyer is string
          && (request.auth.uid == get(offerPath()).data.ownerId || request.auth.uid == buyer)
          && get(buyerRequest(buyer)).data.status == 'accepted';
      }

      function validOutcome(before, after) {
        let ownerAction = request.auth.uid == get(offerPath()).data.ownerId;
        return after.keys().hasOnly(['ownerConfirmedAt', 'partnerConfirmedAt', 'confirmedAt'])
          && get(offerPath()).data.status in ['reserved', 'exchanged']
          && before.confirmedAt == null
          && (ownerAction
            ? before.ownerConfirmedAt == null && after.ownerConfirmedAt == request.time
              && after.partnerConfirmedAt == before.partnerConfirmedAt
            : before.partnerConfirmedAt == null && after.partnerConfirmedAt == request.time
              && after.ownerConfirmedAt == before.ownerConfirmedAt)
          && (after.ownerConfirmedAt != null && after.partnerConfirmedAt != null
            ? after.confirmedAt == request.time && getAfter(offerPath()).data.status == 'exchanged'
              && getAfter(/databases/$(database)/documents/insightEvents/$('confirmed~' + companyId + '~' + listingId)).data.at == request.time
            : after.confirmedAt == null);
      }
      match /private/outcome {
        allow get: if participant();
        allow create: if participant()
          && validOutcome({ 'ownerConfirmedAt': null, 'partnerConfirmedAt': null, 'confirmedAt': null }, request.resource.data);
        allow update: if participant() && validOutcome(resource.data, request.resource.data);
      }

      match /messages/{messageId} {
        allow get: if participant();
        allow list: if participant() && request.query.limit <= 30;
        allow create: if participant()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && listingText(request.resource.data.text, 1000)
          && request.resource.data.createdAt == request.time;
      }
    }

    function insightsAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/insightsAdmins/$(request.auth.uid));
    }
    match /insightsAdmins/{uid} {
      allow get: if owner(uid) && request.auth.token.email_verified == true;
    }
    function insightEventAccess(id) {
      let uid = request.auth.uid;
      return id in ['signup~' + uid, 'verified~' + uid] || id.matches('join~[^~]+~' + uid);
    }
    function insightAccount(id, d) {
      return d.circle == '' && d.post == '' && id == d.kind + '~' + d.uid
        && request.auth.token.get('email', '') != ''
        && (d.kind == 'signup' || (request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/insightEvents/$('signup~' + d.uid))));
    }
    function insightJoin(id, d) {
      let locality = /databases/$(database)/documents/localityMemberships/$(d.uid);
      let member = /databases/$(database)/documents/communities/$(d.circle)/members/$(d.uid);
      return d.post == '' && id == 'join~' + d.circle + '~' + d.uid
        && (supportedArea(d.circle)
          ? verifiedPersonal() && getAfter(locality).data.areaId == d.circle
            && (!exists(locality) || get(locality).data.areaId != d.circle)
          : verifiedCompany(d.circle) && !exists(member)
            && getAfter(member).data.createdAt == request.time
            && getAfter(member).data.status == 'active');
    }
    function insightListing(id, d) {
      let post = /databases/$(database)/documents/communities/$(d.circle)/listings/$(d.post);
      let reply = /databases/$(database)/documents/communities/$(d.circle)/listings/$(d.post)/requests/$(d.uid);
      let outcome = /databases/$(database)/documents/communities/$(d.circle)/listings/$(d.post)/private/outcome;
      let key = d.kind + '~' + d.circle + '~' + d.post;
      return d.post != '' && activeMember(d.circle)
        && id == (d.kind == 'reply' ? key + '~' + d.uid : key)
        && ((d.kind in ['offer', 'ask'] && !exists(post)
            && getAfter(post).data.createdAt == request.time
            && getAfter(post).data.ownerId == d.uid
            && ('askDeadline' in getAfter(post).data) == (d.kind == 'ask'))
          || (d.kind == 'reply' && !exists(reply) && getAfter(reply).data.createdAt == request.time)
          || (d.kind == 'match' && get(post).data.ownerId == d.uid
            && get(post).data.status == 'available' && getAfter(post).data.status == 'reserved')
          || (d.kind == 'closed' && get(post).data.ownerId == d.uid
            && get(post).data.status in ['available', 'reserved'] && getAfter(post).data.status == 'exchanged')
          || (d.kind == 'confirmed' && getAfter(outcome).data.confirmedAt == request.time
            && (!exists(outcome) || get(outcome).data.confirmedAt == null)
            && (getAfter(outcome).data.ownerConfirmedAt == request.time
              ? get(post).data.ownerId == d.uid : get(post).data.ownerId != d.uid)));
    }
    match /insightEvents/{id} {
      allow get: if insightsAdmin() || (request.auth != null && insightEventAccess(id));
      allow list: if insightsAdmin() && request.query.limit <= 250;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'circle', 'post', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.circle is string && request.resource.data.circle.size() <= 253
        && request.resource.data.post is string && request.resource.data.post.size() <= 100
        && (request.resource.data.kind in ['signup', 'verified']
          ? insightAccount(id, request.resource.data)
          : request.resource.data.kind == 'join'
            ? insightJoin(id, request.resource.data)
            : request.resource.data.kind in ['offer', 'ask', 'reply', 'match', 'closed', 'confirmed']
              && insightListing(id, request.resource.data));
    }
    match /insightCoverage/current {
      allow get: if insightsAdmin();
    }
    match /insightReports/{id} {
      function matchesReport() {
        let d = request.resource.data;
        let r = getAfter(feedbackPath(id)).data;
        return d.keys().hasOnly(['uid', 'guest', 'category', 'status', 'createdAt', 'resolvedAt'])
          && d.uid == r.reporterUid
          && d.guest == (r.email == '')
          && d.category == r.category && d.status == r.status && d.createdAt == r.createdAt
          && d.resolvedAt == r.get('resolvedAt', null);
      }
      allow get: if insightsAdmin();
      allow list: if insightsAdmin() && request.query.limit <= 250;
      allow create, update: if matchesReport()
        && ((!exists(feedbackPath(id)) && owner(request.resource.data.uid))
          || (feedbackAdmin() && get(feedbackPath(id)).data.status != request.resource.data.status));
    }


    function feedbackAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/feedbackAdmins/$(request.auth.uid));
    }
    function feedbackPath(id) {
      return /databases/$(database)/documents/feedback/$(id);
    }
    function feedbackOwner(id) {
      return request.auth != null && get(feedbackPath(id)).data.reporterUid == request.auth.uid;
    }
    function feedbackOpen() {
      let config = get(/databases/$(database)/documents/feedbackConfig/pilot).data;
      return config.enabled == true
        && (request.auth.token.firebase.sign_in_provider != 'anonymous' || config.guests == true);
    }
    function feedbackCounter(path, id) {
      let next = getAfter(path).data;
      return next.reportId == id && next.updatedAt == request.time;
    }
    function feedbackCounterWrite(d) {
      return request.auth != null && d.keys().hasOnly(['reportId', 'updatedAt', 'count'])
        && d.reportId is string && d.updatedAt == request.time
        && !exists(feedbackPath(d.reportId))
        && getAfter(feedbackPath(d.reportId)).data.reporterUid == request.auth.uid;
    }
    function feedbackString(value, max) {
      return value is string && value.size() <= max;
    }
    function feedbackIdentity(d) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return d.reporterUid == request.auth.uid
        && d.email == request.auth.token.get('email', '')
        && d.verified == request.auth.token.get('email_verified', false)
        && d.name == (exists(profile) ? get(profile).data.displayName : '');
    }
    function validFeedback(d, id) {
      return d.keys().hasOnly(['reporterUid', 'email', 'verified', 'name', 'category', 'body',
          'screen', 'version', 'viewport', 'browser', 'language', 'circle', 'createdAt', 'status'])
        && feedbackIdentity(d)
        && d.createdAt == request.time && d.status == 'new'
        && d.category in ['bug', 'idea', 'experience']
        && feedbackString(d.body, 2000) && d.body.matches('(?s).*[^\\s].*')
        && d.screen in ['Welcome', 'Email verification', 'Feed', 'Shared listing',
          'Requests', 'Profile', 'Feedback history', 'Other']
        && feedbackString(d.version, 40) && feedbackString(d.viewport, 20)
        && feedbackString(d.browser, 255) && feedbackString(d.language, 35)
        && feedbackString(d.circle, 253)
        && feedbackCounter(/databases/$(database)/documents/feedbackUsage/pilot, id)
        && feedbackCounter(/databases/$(database)/documents/feedbackLimits/$(request.auth.uid), id);
    }

    match /feedbackAdmins/{uid} {
      allow get: if owner(uid) && request.auth.token.email_verified == true;
    }
    match /feedbackConfig/pilot {
      allow get: if true;
    }
    match /feedbackUsage/pilot {
      allow get: if feedbackAdmin();
      allow create: if feedbackCounterWrite(request.resource.data) && request.resource.data.count == 1;
      allow update: if feedbackCounterWrite(request.resource.data)
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 500;
    }
    match /feedbackLimits/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && feedbackCounterWrite(request.resource.data)
        && !('count' in request.resource.data)
        && (resource == null || request.time >= resource.data.updatedAt + duration.value(5, 'm'));
    }
    match /feedback/{id} {
      allow get: if feedbackAdmin() || (request.auth != null
        && (resource != null ? resource.data.reporterUid == request.auth.uid
          : id.matches(request.auth.uid + '_[A-Za-z0-9]{20}')));
      allow list: if request.query.limit <= 25 && (feedbackAdmin() || owner(resource.data.reporterUid));
      allow create: if request.auth != null && feedbackOpen()
        && id.matches(request.auth.uid + '_[A-Za-z0-9]{20}')
        && validFeedback(request.resource.data, id);
      allow update: if feedbackAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['new', 'reviewing', 'planned', 'in progress', 'shipped', 'closed']
        && request.resource.data.resolvedAt == (
          request.resource.data.status in ['closed', 'shipped'] ? request.time : null);
      match /feedbackImages/{slot} {
        allow get: if feedbackAdmin() || feedbackOwner(id);
        allow create: if request.auth != null && slot in ['0', '1']
          && !exists(feedbackPath(id))
          && getAfter(feedbackPath(id)).data.reporterUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['imageBytes'])
          && request.resource.data.imageBytes is bytes
          && request.resource.data.imageBytes.size() > 0
          && request.resource.data.imageBytes.size() <= 153600;
        allow delete: if feedbackAdmin();
      }
    }
    match /feedbackThreads/{id} {
      function validAppend(previous) {
        let next = request.resource.data.messages;
        let message = next[previous.size()];
        let admin = feedbackAdmin();
        return request.auth != null && (admin || feedbackOwner(id)) && exists(feedbackPath(id))
          && request.resource.data.keys().hasOnly(['messages', 'updatedAt']) && request.resource.data.updatedAt == request.time
          && next is list && next.size() <= 30
          && next == previous.concat([message])
          && message.keys().hasOnly(['body', 'author'])
          && ((message.author == 'team' && admin) || (message.author == 'reporter' && feedbackOwner(id)))
          && feedbackString(message.body, 1500) && message.body.matches('(?s).*[^\\s].*');
      }
      allow get: if feedbackAdmin() || feedbackOwner(id);
      allow create: if validAppend([]);
      allow update: if validAppend(resource.data.messages);
    }
    match /feedbackTriage/{id} {
      allow get: if feedbackAdmin();
      allow create, update: if feedbackAdmin() && exists(feedbackPath(id))
        && request.resource.data.keys().hasOnly(['priority', 'notes', 'issue'])
        && request.resource.data.priority in ['normal', 'high']
        && feedbackString(request.resource.data.notes, 2000)
        && request.resource.data.issue is int && request.resource.data.issue >= 0
        && request.resource.data.issue <= 999999999;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
