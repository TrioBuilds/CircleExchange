# Local emulators work without a Firebase account or billing.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-circleexchange.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-circleexchange
VITE_FIREBASE_APP_ID=demo-app-id
# Production: set emulator mode to false and use your Firebase web app config.
